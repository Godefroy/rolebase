{
  "compilerOptions": {
    "module": "preserve",
    "target": "ES2022",
    "allowJs": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "strictNullChecks": true,
    "sourceMap": true,
    "jsx": "react",
    "outDir": "dist"
  }
}
