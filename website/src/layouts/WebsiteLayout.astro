---
import BaseLayout from './BaseLayout.astro'
import CirclesBackground from '../components/CirclesBackground.astro'

interface Props {
  title: string
  /** Appends ` | <brand>` to the document title. */
  titleBrand?: boolean
  description?: string
}

const { title, titleBrand = true, description } = Astro.props
---

<BaseLayout title={title} titleBrand={titleBrand} description={description}>
  <div class="relative overflow-hidden flex-1">
    <CirclesBackground />
    <main class="max-w-7xl mx-auto py-12 px-6">
      <slot />
    </main>
  </div>
</BaseLayout>
