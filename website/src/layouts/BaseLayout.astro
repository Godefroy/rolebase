---
import TopNav from '../components/TopNav.astro'
import TopNavDev from '../components/TopNavDev.astro'
import Footer from '../components/Footer.astro'
import SocialPreview from '../components/SocialPreview.astro'
import JsonLd from '../components/JsonLd.astro'
import config from '../../website.config'
import { getLangFromUrl } from '../utils/i18n'
import { getCanonicalPath } from '../utils/getCanonicalPath'
import '../styles/global.css'

interface Props {
  title: string
  /**
   * Meta description of the page, also reused for the social preview. Comes
   * from the content: `summary` on a blog post, `description` on a doc, a
   * guide or a `pages` entry.
   */
  description?: string
  /** `article` on blog posts, `website` everywhere else. */
  ogType?: 'website' | 'article'
  staticHeader?: boolean
  image?: ImageMetadata
}

const { title, description, ogType = 'website', staticHeader = false, image } = Astro.props
// Index pages carry very short titles ("Blog", "Introduction"), so the brand
// is appended to give them a full document title. It is left out when the title
// already names the brand, and when the suffix would push the title past the
// ~60 characters a SERP displays.
const brandedTitle = `${title} | ${config.siteName}`
const pageTitle
  = title.includes(config.siteName) || brandedTitle.length > 60 ? title : brandedTitle
const currentPath = Astro.url.pathname
const lang = getLangFromUrl(Astro.url)
const isDevSection = currentPath.includes('/developers') || currentPath.includes('/api')
const canonicalPath = getCanonicalPath(currentPath)
const hasLangPrefix = canonicalPath.startsWith(`/${lang}`)
const altPath = (l: string) => hasLangPrefix ? canonicalPath.replace(`/${lang}`, `/${l}`) : canonicalPath

/** Absolute URL of a site-relative path, for the tags that require one. */
const absoluteUrl = (path: string) => new URL(path, Astro.site).href
const canonicalUrl = absoluteUrl(canonicalPath)
const mdAlternateUrl = absoluteUrl(`${canonicalPath}.md`)

// Site-wide structured data, emitted on every page.
const siteUrl = (Astro.site?.href ?? `${config.site}/`).replace(/\/$/, '')
const siteOrganization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': config.siteName,
  'url': `${siteUrl}/`,
  'logo': `${siteUrl}/favicon.svg`,
}
const siteWebsite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': config.siteName,
  'url': `${siteUrl}/`,
  'inLanguage': [...config.langs],
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {hasLangPrefix && config.langs.map((l) => (
      <link rel="alternate" hreflang={l} href={absoluteUrl(altPath(l))} />
    ))}
    {hasLangPrefix && (
      <link rel="alternate" hreflang="x-default" href={absoluteUrl(altPath(config.defaultLang))} />
    )}
    <link
      rel="alternate"
      type="text/markdown"
      href={mdAlternateUrl}
    />
    <SocialPreview
      title={pageTitle}
      description={description}
      image={image}
      type={ogType}
      url={canonicalUrl}
      lang={lang}
    />
    <JsonLd data={siteOrganization} />
    <JsonLd data={siteWebsite} />
    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://umami.internal.lonestone.io/script.js"
        data-website-id="b551cd9c-5426-410a-83ed-94d46b6a7865"></script>
    )}
    <script is:inline>
      window.$crisp=[];window.CRISP_WEBSITE_ID="652544cd-14f6-4c8c-9a04-2a56676dd4a0";
      (function(){var d=document;var s=d.createElement("script");s.src="https://client.crisp.chat/l.js";s.async=1;d.getElementsByTagName("head")[0].appendChild(s);})();
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    {isDevSection ? <TopNavDev /> : <TopNav staticHeader={staticHeader} />}
    <div class="flex-1 flex flex-col">
      <slot />
    </div>
    <Footer />
  </body>
</html>

<script>
  import '../scripts/mermaid.ts'
</script>
