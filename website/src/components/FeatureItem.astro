---
import {
  Home2,
  Hierarchy,
  DocumentText,
  Repeat,
  Calendar,
  SearchNormal1,
  ClipboardImport,
  ExportSquare,
  DocumentDownload,
  NotificationBing,
  Activity,
  ShieldTick,
  Code1,
  Code,
  Data,
  Driver,
  Edit2,
  Category,
  Setting4,
  Flash,
} from 'iconsax-astro'
import SvgIcon from './Icon.astro'

const iconMap: Record<string, any> = {
  dashboard: Home2,
  roles: Hierarchy,
  decisions: DocumentText,
  recurring: Repeat,
  calendar: Calendar,
  search: SearchNormal1,
  'import': ClipboardImport,
  'export': ExportSquare,
  'download': DocumentDownload,
  notifications: NotificationBing,
  activity: Activity,
  governance: ShieldTick,
  opensource: Code1,
  api: Data,
  code: Code,
  selfhost: Driver,
  realtime: Edit2,
  allinone: Category,
  flexible: Setting4,
  simple: Flash,
}

interface Props {
  title: string
  // An iconsax icon from the map above, or the name of an SVG in src/assets/icons
  icon: string
  class?: string
}

const { title, icon, class: className } = Astro.props
const Icon = iconMap[icon]
---

<div class:list={['flex gap-4', className]}>
  <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary-light/10 flex items-center justify-center">
    {Icon ? (
      <Icon size="24" color="var(--color-primary)" />
    ) : (
      <SvgIcon icon={icon} class="w-6 text-primary" />
    )}
  </div>
  <div>
    <h3 class="font-semibold text-base mt-0 mb-1">{title}</h3>
    <p class="text-sm text-text-secondary mt-0 mb-0"><slot /></p>
  </div>
</div>
