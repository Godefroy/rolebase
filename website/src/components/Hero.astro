---
import Button from './Button.astro'
import DemoVideo from './DemoVideo.astro'

interface Props {
  title: string
  subtitle: string
  buttonText: string
  buttonHref: string
  smallText: string
  videoSrc: string
  videoPoster: string
  videoPlayLabel: string
}

const { title, subtitle, buttonText, buttonHref, smallText, videoSrc, videoPoster, videoPlayLabel } = Astro.props
---

<section class="flex flex-col md:flex-row items-center gap-8 md:gap-12 py-12">
  <div class="flex-1">
    <h1 class="text-4xl md:text-5xl font-bold leading-tight mt-0 mb-0">{title}</h1>
    <p class="mt-6 text-lg text-text-secondary">{subtitle}</p>
    <div class="mt-8">
      <Button href={buttonHref} label={buttonText} trackPlacement="hero" />
      <p class="mt-2 text-sm text-text-secondary">{smallText}</p>
    </div>
    <div class="flex items-center gap-4 mt-6 [&_p]:mb-0! [&_p]:contents [&_img]:h-20 [&_img]:w-auto">
      <slot />
    </div>
  </div>
  <div class="w-full flex-1">
    <DemoVideo src={videoSrc} poster={videoPoster} playLabel={videoPlayLabel} />
  </div>
</section>
