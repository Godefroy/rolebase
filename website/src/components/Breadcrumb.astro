---
interface Props {
  /** Ancestors of the page, from the section root down to its direct parent. */
  trail: { label: string; href: string }[]
  title: string
  hideTitle?: boolean
  class?: string
}

const { trail, title, hideTitle = false, class: className } = Astro.props

const linkClass = 'text-text-secondary hover:text-text-main hover:underline transition-colors'
const origin = Astro.site?.origin ?? ''
const items = [{ label: 'Rolebase', href: '/' }, ...trail]
---

<nav class:list={['text-sm text-text-secondary', className]}>
  {items.map((item, i) => (
    <>
      {i > 0 && <span class="mx-1">⟩</span>}
      <a href={item.href} class={linkClass}>{item.label}</a>
    </>
  ))}
  {!hideTitle && (
    <>
      <span class="mx-1">⟩</span>
      <span>{title}</span>
    </>
  )}
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    ...items.map((item, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: item.label,
      item: `${origin}${item.href}`,
    })),
    {
      "@type": "ListItem",
      position: items.length + 1,
      name: title,
      item: `${origin}${Astro.url.pathname.replace(/\.html$/, '')}`,
    },
  ],
})} />
