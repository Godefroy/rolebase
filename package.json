{
  "name": "rolebase",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "postinstall": "patch-package",
    "lint": "eslint ./packages ./functions --ext .jsx,.js,.ts,.tsx",
    "lint:fix": "eslint ./packages ./functions --ext .jsx,.js,.ts,.tsx --fix",
    "lint:format": "prettier --loglevel warn --write \"./{packages,functions}/**/*.{js,jsx,ts,tsx,css,md,json}\" "
  },
  "devDependencies": {
    "@graphql-codegen/add": "^8.0.0",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "@graphql-codegen/typescript-operations": "^7.0.1",
    "@graphql-codegen/typescript-react-apollo": "6.0.0-alpha-20261110130114-66e7e67a38e78ab7516629f6d800b650e2fba942",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^0.6.13",
    "patch-package": "^8.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": "^0.9.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.6"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "googleapis-common": {
      "uuid": "^11.1.1"
    },
    "graphql-config": {
      "minimatch": "^11.0.6"
    },
    "nodemon": {
      "minimatch": "^11.0.6"
    },
    "qs": "^6.17.1"
  }
}
